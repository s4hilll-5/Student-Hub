# Copy to .env.local for local overrides. Never put secrets here: every VITE_* value
# is compiled into the public JavaScript bundle.

# Base URL of the API as seen by the browser. Keep "/api" so requests stay same-origin
# (Vite proxy in development, a reverse proxy / Vercel rewrite in production).
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards /api during `npm run dev`.
VITE_DEV_BACKEND_URL=http://localhost:8080
