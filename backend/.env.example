# Copy this file to backend/.env (it is git-ignored) and fill in real values.
# Spring Boot loads it automatically when you run the app from the backend/ folder.
# Real environment variables always take precedence over this file.

# --- Database (MySQL 8) -------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/studenthub?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=studenthub_app
DB_PASSWORD=DB_PASSWORD

# --- JWT ----------------------------------------------------------------------
# Base64, at least 32 bytes. Generate a fresh one, never reuse an example value:
#   PowerShell: $b = New-Object byte[] 64; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   macOS/Linux/Git Bash: openssl rand -base64 64
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Browser / cookies ----------------------------------------------------------
# Local development runs over plain HTTP, so the refresh cookie can't be "Secure".
# Production (HTTPS) must leave this at true.
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Password reset email ------------------------------------------------------
# false: reset links are printed in the backend console (development only).
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=StudentHub <no-reply@example.com>

# --- Optional first admin account (created on startup if the email is unused) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Misc ------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=dev
# PORT=8080
# RATE_LIMIT_ENABLED=true
